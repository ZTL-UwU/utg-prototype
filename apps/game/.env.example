# Base URL for the backend API
VITE_BACKEND_URL="http://localhost:8000/api"

# "true" unlocks every level and lets level links (e.g. /game/levels/42/play) open without
# logging in: visitors play as a guest and skip avatar select. Other pages still ask to log in.
VITE_OPEN_ACCESS="false"

# "true" prints startup steps and errors on screen in native builds, which have no reachable
# console. It covers the bottom of the game, so leave it off unless debugging.
VITE_NATIVE_DEBUG="false"
