DJANGO_SECRET_KEY=change-me-in-production
JWT_SIGNING_KEY=change-me-separately-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/utg

# Password reset emails. Console backend when DJANGO_DEBUG=true; SMTP otherwise.
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=noreply@utg-prototype
